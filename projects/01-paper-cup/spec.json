    {
      "n": 1,
      "title": "Diagonal valley",
      "foldType": "valley",
      "line": {
        "from": [
          0,
          0
        ],
        "to": [
          1,
          1
        ]
      },
      "direction": "bring-top-left-to-bottom-right",
      "resultShape": "triangle",
      "do": "Fold TL corner to BR.",
      "check": "A triangle.",
      "tip": "Crease with a fingernail.",
      "say": "See this blue line? Fold the top-left corner down to the bottom-right. Press the crease with a fingernail. Your paper should look like a triangle.",
      "cue": {
        "showLine": "blue line",
        "showArrow": "down",
        "fold": "Fold",
        "crease": "Press",
        "resultCheck": "triangle"
      }
    },
    {
      "n": 2,
      "title": "Left corner up",
      "foldType": "valley",
      "direction": "bring-left-corner-to-top",
      "resultShape": "triangle-with-left-flap",
      "do": "Fold left tip to the top.",
      "check": "Left flap meets the peak.",
      "tip": "Keep the triangle stacked.",
      "say": "Now fold the left tip up to the top. Press the crease. The left flap should meet the peak.",
      "cue": {
        "showLine": "fold",
        "showArrow": "up",
        "fold": "fold the left",
        "crease": "Press",
        "resultCheck": "meet the peak"
      }
    },
    {
      "n": 3,
      "title": "Right corner up",
      "foldType": "valley",
      "direction": "bring-right-corner-to-top",
      "resultShape": "cup-sides",
      "do": "Fold right tip to the top.",
      "check": "Both sides match (symmetry).",
      "tip": "Mirror the left fold.",
      "say": "Match the other side \u2014 fold the right tip up the same way. Press. Both sides should match. That is symmetry!",
      "cue": {
        "showArrow": "same way",
        "fold": "fold the right",
        "crease": "Press",
        "resultCheck": "Both sides"
      }
    },
    {
      "n": 4,
      "title": "Front lip down",
      "foldType": "valley",
      "direction": "fold-front-top-into-pocket",
      "resultShape": "front-tucked",
      "do": "Fold the front peak into the pocket.",
      "check": "Front lip tucked.",
      "tip": "Slide into the little pocket.",
      "say": "Fold the front peak down into the little pocket. Press it flat. The front lip should be tucked in.",
      "cue": {
        "showArrow": "into the little pocket",
        "fold": "Fold the front",
        "crease": "Press",
        "resultCheck": "tucked"
      }
    },
    {
      "n": 5,
      "title": "Turn over",
      "foldType": "turn-over",
      "resultShape": "back-ready",
      "do": "Flip the whole model.",
      "check": "Back looks like the front did.",
      "tip": "Like flipping a pancake.",
      "say": "Flip the whole model over, like a pancake. The back should look like the front did.",
      "cue": {
        "fold": "Flip",
        "resultCheck": "back should look"
      }
    },
    {
      "n": 6,
      "title": "Back lip down",
      "foldType": "valley",
      "direction": "fold-back-top-into-pocket",
      "resultShape": "closed-cup",
      "do": "Tuck the back peak the same way.",
      "check": "Both lips locked.",
      "tip": "Same move as step 4.",
      "say": "Tuck the back peak the same way into its pocket. Press. Both lips should be locked.",
      "cue": {
        "showArrow": "same way",
        "fold": "Tuck",
        "crease": "Press",
        "resultCheck": "locked"
      }
    },
    {
      "n": 7,
      "title": "Open the cup",
      "foldType": "unfold",
      "direction": "open-from-top",
      "resultShape": "cup-3d",
      "do": "Squeeze sides, push the bottom flat.",
